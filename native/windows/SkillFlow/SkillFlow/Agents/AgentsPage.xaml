<Page
    x:Class="SkillFlow.Agents.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agents="using:SkillFlow.Agents"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="16,12">
            <FontIcon Glyph="&#xE779;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel>
                <TextBlock Text="My Agents" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="AgentCountText" Text="0 agents" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,0,0,1"/>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Agent list -->
            <ListView Grid.Column="0" x:Name="AgentListView" SelectionMode="Single" SelectionChanged="OnAgentSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="agents:AgentInfo">
                        <StackPanel Padding="0,8" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind EnabledGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind PushDir}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="1,0,0,0"/>

            <!-- Detail area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Agent header -->
                <StackPanel Grid.Row="0" x:Name="AgentHeaderPanel" Padding="16,12" Spacing="4">
                    <TextBlock x:Name="AgentNameText" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="AgentPushDirText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="AgentScanDirsText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Tab selector -->
                <StackPanel Grid.Row="1" Padding="16,0">
                    <NavigationView x:Name="TabNav" PaneDisplayMode="Top" SelectionChanged="OnTabSelectionChanged" IsBackButtonVisible="Collapsed">
                        <NavigationView.MenuItems>
                            <NavigationViewItem Tag="skills" Content="Skills"/>
                            <NavigationViewItem Tag="memory" Content="Memory"/>
                        </NavigationView.MenuItems>
                    </NavigationView>
                </StackPanel>

                <!-- Tab content -->
                <Grid Grid.Row="2">
                    <!-- Skills tab -->
                    <Grid x:Name="SkillsTab" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="16,8">
                            <Button x:Name="ScanButton" Click="OnScan">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                    <TextBlock Text="Scan"/>
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="ScanProgress" IsActive="False" Width="20" Height="20"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="SkillsListView" Padding="16,0,16,12">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="agents:SkillListItem">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Click="OnPullSkill" Tag="{x:Bind Path}" Visibility="{x:Bind CanPullVisibility}" Padding="8,2">
                                                <FontIcon Glyph="&#xE895;" FontSize="12"/>
                                            </Button>
                                            <Button Click="OnDeleteSkill" Tag="{x:Bind Path}" Visibility="{x:Bind CanDeleteVisibility}" Padding="8,2">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="14" Padding="0,8,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </Grid>

                    <!-- Memory tab -->
                    <ScrollViewer x:Name="MemoryTab" Visibility="Collapsed" Padding="16">
                        <StackPanel x:Name="MemoryPanel" Spacing="16"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <Button Grid.Column="1" Click="OnReload" Content="Reload"/>
            </Grid>
        </Border>
    </Grid>
</Page>
