<Page
    x:Class="SkillFlow.Skills.SkillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skills="using:SkillFlow.Skills"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE80F;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel>
                    <TextBlock Text="My Skills" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="SkillCountText" Text="0 skills" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdates" IsEnabled="{x:Bind CanCheckUpdates, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Check Updates"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ImportButton" Click="OnImport" IsEnabled="{x:Bind CanImport, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,0,0,1"/>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category sidebar -->
            <ListView Grid.Column="0" x:Name="CategoryList" SelectionMode="Single" SelectionChanged="OnCategorySelectionChanged">
                <ListViewItem Tag="" Content="All" IsSelected="True"/>
            </ListView>

            <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="1,0,0,0"/>

            <!-- Skill list area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search skills..." MaxWidth="300" HorizontalAlignment="Left" TextChanged="OnSearchChanged"/>
                    <Button Grid.Column="1" x:Name="SortButton" Click="OnSortToggle" Content="A-Z"/>
                    <Button Grid.Column="2" x:Name="ActionsButton" Click="OnActions" IsEnabled="{x:Bind HasSelection, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                            <TextBlock Text="Actions"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Skill list -->
                <ListView Grid.Row="1" x:Name="SkillListView" SelectionMode="Extended" Padding="12,0,12,12" SelectionChanged="OnSkillSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="skills:InstalledSkill">
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind UpdatableGlyph}" FontSize="16" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind PushedAgentsText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <Button Grid.Column="1" Click="OnReload" Content="Reload"/>
            </Grid>
        </Border>
    </Grid>
</Page>
