<Page
    x:Class="SkillFlow.Backup.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="16,12">
            <FontIcon Glyph="&#xE7C4;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel>
                <TextBlock Text="Cloud Backup" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Backup, restore, and manage cloud sync." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,0,0,1"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" Padding="24">
            <StackPanel x:Name="ContentPanel" Spacing="24" MaxWidth="880" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <Button Grid.Column="1" Click="OnReload" Content="Reload"/>
            </Grid>
        </Border>
    </Grid>
</Page>
