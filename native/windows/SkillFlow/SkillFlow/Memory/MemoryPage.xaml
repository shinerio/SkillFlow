<Page
    x:Class="SkillFlow.Memory.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE8D5;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel>
                    <TextBlock Text="My Memory" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Manage main memory, modules, and push configuration." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PushAllButton" Click="OnPushAll">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                        <TextBlock Text="Push All"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,0,0,1"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" Padding="24">
            <StackPanel x:Name="ContentPanel" Spacing="24" MaxWidth="880" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <Button Grid.Column="1" Click="OnReload" Content="Reload"/>
            </Grid>
        </Border>
    </Grid>
</Page>
